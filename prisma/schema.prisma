generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATING
  CLOSED
}

enum LeadSource {
  WEBSITE
  LINKEDIN
  REFERRAL
  INSTAGRAM
  COLD_OUTREACH
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String

  leads        Lead[]
  notes        Note[]
  followUps    FollowUp[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}pdatedAt    DateTime @updatedAt


model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String?
  phone       String?
  source      LeadSource
  status      LeadStatus @default(NEW)
  notes       String?
  followUpAt  DateTime?

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  leadNotes   Note[]
  followUps   FollowUp[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([followUpAt])
  @@index([createdById])
}

model Note {
  id        String   @id @default(cuid())
  content   String

  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdById])
  @@index([createdAt])
}

model FollowUp {
  id        String   @id @default(cuid())
  dueAt     DateTime
  completedAt DateTime?
  note      String?

  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([dueAt])
  @@index([completedAt])
  @@index([createdById])
}
